{
    "name": "@dosfilos/mcp",
    "version": "0.1.0",
    "private": true,
    "description": "Servidor MCP del corpus (lectura) con OAuth 2.1. Empaqueta el dominio con esbuild: las funciones de packages/functions no pueden importarlo.",
    "main": "dist/index.js",
    "engines": {
        "node": "22"
    },
    "scripts": {
        "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.js --external:firebase-admin --external:firebase-functions --tsconfig=tsconfig.json --log-level=warning",
        "test": "vitest run",
        "type-check": "tsc --noEmit -p . 2>&1 | grep -E '^src/.*error TS' && exit 1 || exit 0"
    },
    "dependencies": {
        "firebase-admin": "^12.0.0",
        "firebase-functions": "^7.3.2"
    },
    "devDependencies": {
        "esbuild": "^0.25.0"
    }
}
