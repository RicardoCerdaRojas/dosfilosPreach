{
    "compilerOptions": {
        "target": "ES2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "noUncheckedIndexedAccess": true,
        "baseUrl": ".",
        "paths": {
            "@dosfilos/domain": [
                "../domain/src"
            ],
            "@dosfilos/domain/*": [
                "../domain/src/*"
            ],
            "@/*": [
                "../web/src/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts"
    ]
}
