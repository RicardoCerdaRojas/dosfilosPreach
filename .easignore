# GENERADO a partir de los .gitignore del repo + exclusiones propias.
# Con un .easignore, EAS deja de leer los .gitignore: sus reglas tienen que
# estar acá, cada una con su carpeta. Si cambia un .gitignore, regenerar.

# --- .gitignore (raíz) ---
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Lock files — yarn.lock is the source of truth (yarn 1.x workspaces).
# package-lock.json gets regenerated by stray `npm install` commands and
# drifts from yarn.lock; ignoring it prevents accidental commits that
# break CI (`npm ci` vs `yarn install` mismatch).
package-lock.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables
.env
.env.local
.env.*.local
.env.production
.env.bak*
.env.backup*

# Claude Code agent config (per-user)
.claude/

# Firebase
.firebase/
.firebaserc
firebase-debug.log
firestore-debug.log
ui-debug.log

# Build artifacts
build/
coverage/
*.tsbuildinfo

# Testing
.nyc_output

# Misc
.cache
.temp
.tmp

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Mobile
packages/mobile/.expo/
packages/mobile/dist/
packages/mobile/web-build/
packages/mobile/ios/
packages/mobile/android/

# Root Level Generated Files
.npm-cache
.expo/
.agent/
.npm/

# Generated Native Projects (at root)
/android/
/ios/

# Local agent/MCP tooling (byblos, atlassian) — never committed.
# byblos in particular must NOT land in package.json: it breaks CI's
# `ls-remote`. It lives in .mcp.json locally only.
.byblos/
.atl/
.mcp.json
.husky/post-commit

# Salidas del banco de pruebas de extracción (contienen texto de libros con derechos)
bakeoff-out/

# Tarifas reales de facturación — no van al repo
scripts/extraction-bakeoff/rates.json

# Activos de pdf.js copiados por `predev`/`prebuild`
# (packages/web/scripts/copy-pdfjs-assets.mjs). Son GENERADOS: 198 archivos,
# incluido JS minificado que eslint intenta analizar y produce ~1.000 errores.
# Sin esta regla, cualquier `git add -A` después de correr la app los versiona.
packages/web/public/pdfjs/

# Clave de la cuenta de servicio de Google Play (eas submit). Nunca al repo.
packages/mobile/play-service-account.json

# --- packages/landing/.gitignore ---
packages/landing/**/dist/
packages/landing/**/.astro/
packages/landing/**/node_modules/

# --- packages/mobile/.gitignore ---
# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
packages/mobile/**/node_modules/

# Expo
packages/mobile/**/.expo/
packages/mobile/**/dist/
packages/mobile/**/web-build/
packages/mobile/**/expo-env.d.ts

# Native
packages/mobile/**/.kotlin/
packages/mobile/**/*.orig.*
packages/mobile/**/*.jks
packages/mobile/**/*.p8
packages/mobile/**/*.p12
packages/mobile/**/*.key
packages/mobile/**/*.mobileprovision

# Metro
packages/mobile/**/.metro-health-check*

# debug
packages/mobile/**/npm-debug.*
packages/mobile/**/yarn-debug.*
packages/mobile/**/yarn-error.*

# macOS
packages/mobile/**/.DS_Store
packages/mobile/**/*.pem

# local env files
packages/mobile/**/.env*.local

# typescript
packages/mobile/**/*.tsbuildinfo

packages/mobile/**/app-example

# generated native folders
packages/mobile/ios
packages/mobile/android

# --- packages/web/.gitignore ---
packages/web/public/pdfjs/

# --- Exclusiones propias del build de la tablet ---
# Lo que el build de la app móvil (EAS) no necesita subir.
#
# EAS copia el repositorio desde git: lo que .gitignore ya excluye nunca se
# sube. Esto sólo saca lo que pesa y la tablet no usa. Con todo el monorepo
# el paquete pesaba 49 MB y la subida se cortaba a mitad (2026-10-05).
# Se dejan todos los package.json y scripts/: la instalación los necesita.
.git
node_modules

# Documentación.
docs/

# Las Biblias de la web, de infraestructura y de la raíz (la tablet lleva
# las suyas en packages/mobile/assets/bible).
/rvr1960.json
packages/web/src/assets/bible/
packages/infrastructure/src/bible/data/

# Diseños de referencia de la tablet (sólo para mirar).
packages/mobile/stitch_design.mobile/

# Imágenes públicas de la web y la landing.
packages/web/public/
packages/landing/public/
