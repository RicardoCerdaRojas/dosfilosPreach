{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "hosting": [
        {
            "target": "app",
            "public": "packages/web/dist",
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ],
            "rewrites": [
                {
                    "source": "/mcp",
                    "run": {
                        "serviceId": "mcpgateway",
                        "region": "us-central1"
                    }
                },
                {
                    "source": "/oauth/**",
                    "run": {
                        "serviceId": "mcpgateway",
                        "region": "us-central1"
                    }
                },
                {
                    "source": "/.well-known/oauth-authorization-server",
                    "run": {
                        "serviceId": "mcpgateway",
                        "region": "us-central1"
                    }
                },
                {
                    "source": "/.well-known/oauth-authorization-server/**",
                    "run": {
                        "serviceId": "mcpgateway",
                        "region": "us-central1"
                    }
                },
                {
                    "source": "/.well-known/oauth-protected-resource",
                    "run": {
                        "serviceId": "mcpgateway",
                        "region": "us-central1"
                    }
                },
                {
                    "source": "/.well-known/oauth-protected-resource/**",
                    "run": {
                        "serviceId": "mcpgateway",
                        "region": "us-central1"
                    }
                },
                {
                    "source": "**",
                    "destination": "/index.html"
                }
            ],
            "headers": [
                {
                    "source": "/conectar",
                    "headers": [
                        {
                            "key": "X-Frame-Options",
                            "value": "DENY"
                        },
                        {
                            "key": "Content-Security-Policy",
                            "value": "frame-ancestors 'none'"
                        }
                    ]
                }
            ]
        },
        {
            "target": "marketing",
            "public": "packages/landing/dist",
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ],
            "redirects": [
                {
                    "source": "/",
                    "destination": "/es/",
                    "type": 301
                },
                {
                    "source": "/login",
                    "destination": "https://app.preach.dosfilos.com/login",
                    "type": 301
                },
                {
                    "source": "/register",
                    "destination": "https://app.preach.dosfilos.com/register",
                    "type": 301
                },
                {
                    "source": "/dashboard",
                    "destination": "https://app.preach.dosfilos.com/dashboard",
                    "type": 301
                },
                {
                    "source": "/dashboard/:rest*",
                    "destination": "https://app.preach.dosfilos.com/dashboard/:rest*",
                    "type": 301
                }
            ]
        }
    ],
    "functions": [
        {
            "source": "packages/functions",
            "codebase": "default",
            "runtime": "nodejs22",
            "predeploy": [
                "npm --prefix \"$RESOURCE_DIR\" run build"
            ]
        },
        {
            "source": "packages/mcp",
            "codebase": "mcp",
            "runtime": "nodejs22",
            "ignore": [
                "node_modules",
                "src",
                ".git",
                "*.log",
                "vitest.config.ts",
                "tsconfig.json"
            ],
            "predeploy": [
                "npm --prefix \"$RESOURCE_DIR\" run build"
            ]
        }
    ],
    "storage": {
        "rules": "storage.rules"
    },
    "emulators": {
        "auth": {
            "port": 9099
        },
        "functions": {
            "port": 5001
        },
        "firestore": {
            "port": 8080
        },
        "hosting": {
            "port": 5000
        },
        "storage": {
            "port": 9199
        },
        "ui": {
            "enabled": true,
            "port": 4000
        },
        "singleProjectMode": true
    }
}
