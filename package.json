{
  "name": "dosfilos-preach",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "description": "Sistema de herramientas para pastores y predicadores - Gestor y Generador de Sermones",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "nohoist": [
      "**/@dosfilos/mobile",
      "@dosfilos/mobile/**"
    ]
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "type-check:web": "./scripts/check-web-types.sh",
    "type-check:web:update": "./scripts/check-web-types.sh --update",
    "test": "vitest",
    "test:unit": "./scripts/test-all-packages.sh",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-dosfilos-rules \"vitest run --config vitest.rules.config.ts\"",
    "audit:features": "ts-node scripts/audit-feature-ids.ts",
    "audit:features:simple": "node scripts/audit-feature-ids-simple.js",
    "compliance": "./scripts/check-compliance.sh",
    "compliance:staged": "./scripts/check-compliance.sh --staged",
    "compliance:gemini-sdk": "./scripts/check-gemini-sdk-boundary.sh",
    "compliance:i18n": "./scripts/check-i18n-hardcoded.sh",
    "compliance:secrets": "./scripts/check-functions-secrets.sh",
    "compliance:soft": "./scripts/check-compliance.sh --soft",
    "prepare": "husky install",
    "migrate:plans": "node scripts/migrate-plans-phase1.js",
    "migrate:plans:hito4": "node scripts/migrate-plans-to-new-structure.js",
    "seed:translations": "node scripts/seed-plan-translations.js",
    "seed:translations:v2": "node scripts/seed-plan-translations-v2.js",
    "migrate:hide-free": "node scripts/hide-free-plan.js",
    "deploy:rules": "firebase deploy --only firestore:rules --project dosfilosapp",
    "deploy:functions": "firebase deploy --only functions --project dosfilosapp",
    "deploy:hosting": "firebase deploy --only hosting --project dosfilosapp",
    "mobile": "npm run start --workspace=packages/mobile",
    "mobile:android": "npm run android --workspace=packages/mobile",
    "mobile:ios": "npm run ios --workspace=packages/mobile",
    "mobile:web": "npm run web --workspace=packages/mobile",
    "test:root": "vitest run",
    "postinstall": "node scripts/dedupe-nested-react.js && node scripts/dedupe-nested-firebase.js",
    "bakeoff": "node scripts/extraction-bakeoff/run.mjs",
    "diagnosticar": "node --experimental-strip-types --no-warnings scripts/diagnosticar-pdf.ts",
    "bakeoff:test": "vitest run scripts/extraction-bakeoff"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^20.10.0",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.29.1",
    "happy-dom": "^20.9.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.0",
    "typescript": "~5.3.3",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "^3.11.1",
    "@tiptap/react": "^3.11.1",
    "@tiptap/starter-kit": "^3.11.1",
    "react": "18.3.1",
    "react-native": "0.76.6"
  },
  "overrides": {
    "react-native": "0.76.6",
    "expo": "~52.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ajv": "^8.12.0",
    "eslint": {
      "ajv": "^6.12.6"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.6"
    },
    "ajv-keywords": "^5.1.0",
    "@types/react": "~18.3.12",
    "@types/react-dom": "~18.3.0"
  }
}
