rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isFunction() {
      // Cloud Functions have special admin access
      return request.auth.token.firebase.sign_in_provider == 'custom';
    }
    
    // Check if user is super admin (for analytics dashboard)
    function isSuperAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }
    
    function isValidSermon() {
      let sermon = request.resource.data;
      let isDraft = sermon.status == 'draft';
      return sermon.title is string &&
             sermon.title.size() >= 5 &&
             sermon.title.size() <= 200 &&
             sermon.content is string &&
             (isDraft || sermon.content.size() > 0) && // Allow empty content for drafts
             sermon.userId is string &&
             sermon.createdAt is timestamp;
    }
    
    // Teaching Suite (F1) — lectura owner-scoped; las escrituras van solo por
    // callables (Admin SDK, que bypassa estas reglas). Cliente: solo lee lo suyo.
    match /teachingClasses/{id} {
      allow read: if isOwner(resource.data.ownerId) || isSuperAdmin();
      allow write: if false;
    }
    match /teachingPlans/{id} {
      allow read: if isOwner(resource.data.ownerId) || isSuperAdmin();
      allow write: if false;
    }
    match /teachingBrands/{id} {
      allow read: if isOwner(resource.data.ownerId) || isSuperAdmin();
      allow write: if false;
    }
    // Jobs de generación de plan (F3) — el cliente solo LEE su job (onSnapshot);
    // crear/actualizar va por callable + trigger (Admin SDK, bypassa reglas).
    match /teachingPlanJobs/{id} {
      allow read: if isOwner(resource.data.ownerId) || isSuperAdmin();
      allow write: if false;
    }
    // Biblioteca de láminas reutilizables (F4 «trinquete») — el cliente LEE las
    // suyas para reusarlas; promover/eliminar va por callable (Admin SDK).
    // (La colección de ocurrencias `teachingCanvasForms` es server-only: el
    // cliente nunca la lee, recibe las candidatas en la respuesta del callable.)
    match /teachingCanvasComponents/{id} {
      allow read: if isOwner(resource.data.ownerId) || isSuperAdmin();
      allow write: if false;
    }

    // Sermons collection
    match /sermons/{sermonId} {
      // Allow reading individual sermons
      allow get: if isOwner(resource.data.userId) || resource.data.isShared == true || isSuperAdmin();
      
      // Allow listing/querying sermons (for collections, version history, analytics)
      // Security is enforced by requiring userId in the query itself or being super admin
      allow list: if isAuthenticated() || isSuperAdmin();
      
      allow create: if isAuthenticated() && 
                       request.auth.uid == request.resource.data.userId &&
                       isValidSermon();
      allow update: if isOwner(resource.data.userId) && isValidSermon();
      allow delete: if isOwner(resource.data.userId);
      
      // Allow super admins to read & list wizardProgress subcollection for analytics
      match /wizardProgress/{progressId} {
        allow get, list: if isOwner(get(/databases/$(database)/documents/sermons/$(sermonId)).data.userId) || isSuperAdmin();
        allow create, update, delete: if isOwner(get(/databases/$(database)/documents/sermons/$(sermonId)).data.userId);
      }

      // Allow access to annotations subcollection
      match /annotations/{annotationId} {
        allow read, write: if isOwner(get(/databases/$(database)/documents/sermons/$(sermonId)).data.userId);
      }

      // Historial de versiones por sección (antes sólo vivía en localStorage,
      // así que se perdía al cambiar de navegador o de equipo). Un documento
      // por tipo de contenido: sermon | homiletics | exegesis.
      // Misma regla que annotations: sólo el dueño del sermón.
      match /contentHistory/{contentType} {
        allow read, write: if isOwner(get(/databases/$(database)/documents/sermons/$(sermonId)).data.userId);
      }

      // PR #219: Sermon wizard chat history per phase. One doc per
      // phase (exegesis / homiletics / sermon). Owner-only access —
      // matches the parent sermon document's userId.
      match /wizard_chats/{phase} {
        allow read, write: if isOwner(get(/databases/$(database)/documents/sermons/$(sermonId)).data.userId);
      }
    }

    // Greek Sessions (correct collection name)
    match /greek_sessions/{sessionId} {
      // Super admins can read all sessions for analytics
      allow get: if isOwner(resource.data.userId) || isSuperAdmin();
      allow list: if isAuthenticated() || isSuperAdmin();
      allow update, delete: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;

      match /insights/{insightId} {
        allow read, write: if isAuthenticated() && 
           get(/databases/$(database)/documents/greek_sessions/$(sessionId)).data.userId == request.auth.uid;
      }
    }

    // Greek Tutor - Passage Cache (global, reusable across users)
    // All authenticated users can read cached passages
    // All authenticated users can write (to contribute to cache)
    match /passage_cache/{passageId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Greek Tutor - Quiz Cache (hybrid caching by lemma+category)
    // All authenticated users can read and write to benefit from shared cache
    match /quiz_cache/{cacheKey} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Greek Tutor - Syntax Analysis Cache (Phase 4B)
    // Global cache for passage syntax analyses, reusable across users/sessions
    // Reduces Gemini API costs and improves latency for common passages
    match /syntax_analysis_cache/{passageId} {
      allow read: if isAuthenticated(); // All users benefit from cache
      allow create, update: if isAuthenticated(); // Anyone can populate cache
      allow delete: if false; // Cache is permanent (no deletion)
    }

    // Hebrew Tutor - Verse Analysis Cache
    // Global cache for Hebrew verse analyses, reusable across users/sessions
    match /hebrew_analysis_cache/{passageId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // Greek Analyzer - hallazgos del pastor para su sermón (por usuario)
    // Púlpito — marcas del pastor sobre el texto bíblico.
    // Ancladas por (versión, libro, capítulo, versículo): a diferencia del
    // sermón, el versículo es una dirección estable y no hace falta reanclar
    // por offsets. Owner-scoped y editable: una marca se cambia de color o se
    // borra, no es un registro de auditoría.
    match /users/{userId}/bibleMarks/{markId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Notas manuscritas sobre el texto bíblico. Colección propia y no dentro
    // de bibleMarks: son documentos de otra forma (trazos, no color y estilo)
    // y mezclarlos obligaría a filtrar por tipo en cada lectura.
    match /users/{userId}/bibleInk/{noteId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId}/greekFindings/{findingId} {
      allow read, create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if false;
    }

    // Greek Analyzer - Verse Insight Cache
    // Global cache: the Greek text is the same for everyone, so one paid
    // analysis serves all users. Same contract as hebrew_analysis_cache.
    match /greek_insight_cache/{passageId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // Hebrew Tutor - Detective Sessions
    // Stores completed detective sessions for analytics and progress tracking
    match /hebrewDetectiveSessions/{sessionId} {
      allow get: if isOwner(resource.data.userId) || isSuperAdmin();
      allow list: if isAuthenticated() || isSuperAdmin();
      allow update, delete: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // Hebrew Tutor - Study Sessions
    // Owner-managed sessions written by FirestoreHebrewStudySessionRepository.
    // Read by UsageLimitsService for monthly quota counting and by analytics.
    match /hebrew_user_sessions/{sessionId} {
      allow get: if isOwner(resource.data.userId) || isSuperAdmin();
      allow list: if isAuthenticated() || isSuperAdmin();
      allow update, delete: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // Greek Tutor - Word Cache (Global lemma-based cache)
    // Stores gloss and grammatical category for Greek lemmata
    // Shared across all users to reduce API costs by ~50-60%
    match /greekWordCache/{cacheId} {
      allow read: if isAuthenticated(); // All users benefit from cache
      allow create, update: if isAuthenticated(); // Anyone can populate cache
      allow delete: if false; // Cache is permanent (no deletion)
    }
    
    // Users collection
    // Note: isSuperAdmin() with get() doesn't work for list operations
    // Frontend enforces role-based access control
    match /users/{userId} {
      // Allow read for authenticated users (needed for admin dashboard and Core Library)
      // Security is enforced at the application level with role checks
      allow get, list: if isAuthenticated();
      
      // Allow write for owner
      allow write: if isOwner(userId);
      
      // Allow Cloud Functions to update subscription fields
      allow update: if isFunction() &&
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscription', 'stripeCustomerId', 'updatedAt', 'analytics', 'role', 'metadata', 'featureFlags']));
      
      // User settings subcollection (library categories, etc.)
      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // 3rd-party integration credentials (WordPress, future:
      // Mailchimp, Substack, etc.). Owner-only — credentials are
      // sensitive (app passwords, API keys). Cloud Functions read
      // via Admin SDK and bypass these rules.
      match /integrations/{provider} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Hourly counters used for rate-limit guards on send/publish
      // actions. Owner-only read; Cloud Functions write via Admin SDK.
      match /email_sends_hourly/{hourBucket} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /wp_publishes_hourly/{hourBucket} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      
      // Seminary Faculty - AI Chat Sessions
      match /ai_sessions/{sessionId} {
        // Superadmin read for the admin user-activity panel (recent Faculty
        // sessions). Write stays owner-only — admins never mutate user sessions.
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if isOwner(userId);
      }
      
      // Greek Tutor - Personal Insights (user's knowledge base)
      // Users can manage their own insights
      match /greek_insights/{insightId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && resource.data.userId == userId;
        allow delete: if isOwner(userId) && resource.data.userId == userId;
      }

      // Usage counters — monthly quota counters per period key (YYYY-MM).
      // Read by the dashboard UsageBanner / SubscriptionPage so the user can
      // see their progress vs plan limits. Cloud Functions write the counter
      // increments; the user can read but never modify directly.
      match /usage_counters/{periodKey} {
        allow read: if isOwner(userId);
        allow write: if isFunction();
      }

      // Bonus grants (Stripe webhook idempotency markers for plan-bonus pages).
      // Read-only for the owner so the dashboard can show grant history.
      match /bonus_grants/{grantId} {
        allow read: if isOwner(userId);
        allow write: if isFunction();
      }

      // Credit-pack purchases (Stripe webhook records for one-time pack buys).
      match /credit_pack_purchases/{purchaseId} {
        allow read: if isOwner(userId);
        allow write: if isFunction();
      }
    }
    
    // Tags collection (shared across users)
    match /tags/{tagId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only created by cloud functions
    }

    // Pastoral Fidelity — CORE Library confession catalog (ADR-006, PR 0.2).
    // Read is open to authenticated users so the wizard, citation engine and
    // admin viewer can resolve references without per-user proxies. Writes go
    // exclusively through the `ingestCoreLibraryConfessions` callable
    // (super-admin gated) via the Admin SDK, which bypasses these rules.
    match /confessions/{confessionId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /sections/{sectionId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // Pastoral Fidelity — Bible cross-references engine (ADR-008, PR 0.5).
    // Testigo 2 in Phase 2 consumes this from regular user sessions, so reads
    // stay open. Writes flow exclusively through the
    // `ingestBibleCrossReferences` Cloud Function (super-admin gated).
    match /bibleCrossReferences/{verseRef} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Pastoral Fidelity — ADR-036 verified misreadings (anchor fidelity).
    // El merge runtime (PR5) los lee desde sesiones de usuario, así que la
    // lectura queda abierta a autenticados. Las escrituras fluyen SOLO por las
    // Cloud Functions `ingestVerifiedMisreading` / `reviewVerifiedMisreading`
    // (role-gated: super_admin placeholder hasta asignar `floor-reviewer`).
    match /verifiedMisreadings/{id} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Pastoral Fidelity — Phase 1 six-step spine seeds (ADR-015).
    // Top-level collection keyed by sermon. Owner-only: pastor reads + writes
    // their own seeds. Super admins read for the audit inspector.
    // No writes from anyone other than the owner — the seed is the pastor's
    // own voice and cannot be authored on their behalf.
    match /pastoralSeeds/{seedId} {
      // El id del documento ES el `sermonId` desde #454, y `create()` abre una
      // transacción que PRIMERO LEE ese documento para no crear un gemelo.
      // Sobre un documento ausente `resource` es null: desreferenciar
      // `resource.data` hace fallar la expresión y Firestore responde
      // permission-denied, NO "no encontrado". Sin el caso `resource == null`
      // la regla prohíbe leer lo que todavía no existe, y por eso el seed no se
      // podía crear nunca — recargar no ayudaba porque el documento jamás iba a
      // aparecer. #454 introdujo la lectura y no tocó este archivo; roto para
      // todo sermón nuevo entre el 2026-08-23 y el 2026-09-15.
      //
      // Observar la ausencia no concede nada: la creación sigue guardada por
      // `allow create`, que exige que el userId escrito sea el del llamador.
      allow get: if isSuperAdmin()
                 || (resource == null && isAuthenticated())
                 || isOwner(resource.data.userId);
      allow list: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.sermonId is string
                    && request.resource.data.passage is string;
      allow update: if isOwner(resource.data.userId)
                    && request.auth.uid == request.resource.data.userId
                    && resource.data.sermonId == request.resource.data.sermonId;
      allow delete: if isOwner(resource.data.userId);

      // Pastoral Fidelity Phase 1.6 — first-class assist audit (ADR-024).
      // Append-only subcollection. The seed owner reads + creates their own
      // logs; updates/deletes are forbidden (audit integrity feeds "% tuyo").
      // Cloud Functions (admin SDK) bypass these rules.
      match /aiAssistLogs/{logId} {
        allow read: if isOwner(resource.data.userId) || isSuperAdmin();
        allow create: if isAuthenticated()
                      && request.auth.uid == request.resource.data.userId;
        allow update, delete: if false;
      }

      // Pastoral Fidelity Phase 2.5 — Study Companion coverage state
      // (ADR-025/027). Single doc `studyDepth/current` holding the pastor's
      // per-dimension manual overrides. Ownership derives from the parent
      // seed (the subdoc itself stores no userId). Cloud Functions bypass.
      match /studyDepth/{docId} {
        allow read, write: if isAuthenticated()
          && get(/databases/$(database)/documents/pastoralSeeds/$(seedId)).data.userId == request.auth.uid;
      }
    }

    // Pastoral Fidelity Phase 1.5 — pastoral word analysis cache (ADR-017/019).
    // Transversal cache: any authenticated user reads cached analyses; only the
    // `analyzeWordPastorally` Cloud Function writes (admin SDK bypasses these
    // rules). Doc id is deterministic
    // (`${language}__${lemma}__${passageHash}__${curatedVersion}`) so curated
    // dataset bumps invalidate cache by changing the version segment.
    match /pastoralWordAnalyses/{analysisId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Pastoral Fidelity Phase 2 — three-witnesses validation cache (ADR-011).
    // Transversal cache: any authenticated user reads cached witness verdicts;
    // only the `validateSeedWitnesses` Cloud Function writes (admin SDK bypasses
    // these rules). Doc id is deterministic over the claim texts + confessional
    // witnesses toggle + prompt version, so editing a claim or bumping the
    // prompts invalidates the cache by changing the id.
    match /witnessResults/{resultId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Grieta doxológica — Capa 1 (modo sombra). Telemetría del gate doxológico
    // (texto completo del pastor + veredicto + latencia) escrita SOLO por el
    // callable `recordDoxologicalGateShadow` (admin SDK, server-only). Lectura
    // restringida a super_admin para adjudicar la tasa de falsos positivos
    // antes del flip a enforce. TTL nativo de 30 días sobre `expiresAt`.
    match /doxologicalGateShadow/{shadowId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Pastoral Fidelity — confession change audit log (ADR-007, PR 0.7).
    // Each row records a single declaredConfession transition (onboarding
    // declaration + later edits in /settings/confession). Owners may
    // append rows for their own user id; updates + deletes are blocked
    // so the trail is append-only. Reads are restricted to super_admins
    // and the row owner.
    match /confessionChangeAudit/{auditId} {
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow update, delete: if false;
    }

    // Hebrew Tutor - Contextual Hints Catalog
    match /hebrewTutor/config/hints/{hintId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Hebrew Tutor - Lexical Glossary
    match /hebrewTutor/config/lexicon/{entryId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // AI Agents Collection (Seminary Faculty)
    match /ai_agents/{agentId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Workflow Configurations
    match /workflow_configs/{configId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    // Sermon Series collection (legacy collection name kept for backward compat)
    match /series/{seriesId} {
      allow get: if isOwner(resource.data.userId) || isSuperAdmin();
      allow list: if isAuthenticated() || isSuperAdmin();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    // Sermon Series collection — canonical collection name used by
    // FirebaseUserActivityRepository (seriesCollection = 'sermon_series')
    // and the admin user-detail activity widget. Same access semantics as
    // /series/.
    match /sermon_series/{seriesId} {
      allow get: if isOwner(resource.data.userId) || isSuperAdmin();
      allow list: if isAuthenticated() || isSuperAdmin();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    // Library Resources collection
    match /library_resources/{resourceId} {
      // Allow read for authenticated users (needed for Core Library queries with isCore filter)
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    // Document Chunks collection (for semantic search)
    // Note: read/delete rules are relaxed because batch operations need to work
    // The actual resource access is protected by library_resources rules
    match /document_chunks/{chunkId} {
      allow read: if isAuthenticated(); // Allow read for batch queries
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isOwner(resource.data.userId);
      allow delete: if isAuthenticated(); // Allow delete for batch operations
    }

    // Contact Leads collection (from landing page)
    // Anyone can create a lead (for contact form)
    // Only super admin can read all leads
    match /contact_leads/{leadId} {
      allow create: if true; // Public form submission
      allow read, update, delete: if isSuperAdmin();
    }

    // Lead magnet submissions (from /recursos/* funnel pages)
    // The captureLead Cloud Function writes via admin SDK so it
    // bypasses these rules entirely; the client SDK only reads,
    // and only the super admin can do so (admin dashboard).
    // `update` is allowed for the admin to bump nurtureStage; the
    // resendLeadMagnet callable also runs server-side and bypasses
    // these rules.
    match /lead_magnet_submissions/{submissionId} {
      allow read, update, delete: if isSuperAdmin();
      // No client-side create — the captureLead callable is the only
      // legitimate writer (admin SDK bypasses these rules).
      allow create: if false;
    }

    // Per-IP rate-limit counters used by captureLead. Written from
    // the admin SDK inside the Cloud Function (which bypasses rules).
    // Admin-only client read for forensic inspection of abusers.
    // Never client-writable.
    match /rate_limits/{ipKey} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Plans collection (subscription plan definitions)
    // PUBLIC READ - Landing page needs to show plans without authentication
    // Only admin or Cloud Functions can modify
    match /plans/{planId} {
      allow read: if true; // Public read for landing page
      allow write: if isFunction() || isSuperAdmin();
    }

    // Plan Translations collection (i18n for plans)
    // PUBLIC READ - Landing page needs translations without authentication
    // Only admin or Cloud Functions can modify
    match /plan_translations/{planId} {
      allow read: if true; // Public read for landing page
      allow write: if isFunction() || isSuperAdmin();
    }

    // Preaching Plans collection
    match /preaching_plans/{planId} {
      allow read: if isOwner(resource.data.userId) || isSuperAdmin();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    // 🎯 Core Library Configuration (global stores metadata)
    // All authenticated users can read (to use core library)
    // Only admin can write (to create/update stores)
    match /config/coreLibraryStores {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ===========================
    // 📊 ANALYTICS COLLECTIONS
    // ===========================
    
    // Daily Metrics - Aggregated analytics data
    // Only super admins can read, only Cloud Functions can write
    match /daily_metrics/{metricId} {
      allow read: if isSuperAdmin();
      allow write: if isFunction();
    }
    
    // User Activities - User session tracking
    // Only super admins can read, only Cloud Functions can write
    match /user_activities/{activityId} {
      allow read: if isSuperAdmin();
      allow write: if isFunction();
    }
    
    // Geographic Events - Anonymous tracking allowed
    // For landing page tracking, registration, and login analytics
    match /geo_events/{eventId} {
      // Allow anonymous creation (landing page visits)
      // TODO: Add rate limiting via Cloud Function or reCAPTCHA
      allow create: if true;
      
      // Only super admins can read and delete
      allow read, delete: if isSuperAdmin();
      
      // Events are immutable - no updates allowed
      allow update: if false;
    }
    
    // ==========================================
    // EVENT-DRIVEN ANALYTICS COLLECTIONS
    // ==========================================
    
    // User Analytics - Pre-aggregated metrics per user
    match /user_analytics/{userId} {
      // Super admins can read all user analytics
      allow read: if isSuperAdmin();
      
      // Users can read their own analytics
      allow read: if isOwner(userId);
      
      // Only Cloud Functions can write
      allow write: if false;
    }
    
    // Global Metrics - Platform-wide analytics (aggregate)
    match /global_metrics/{document=**} {
      // Only super admins can read
      allow read: if isSuperAdmin();
      
      // Only Cloud Functions can write
      allow write: if false;
    }
    
    // Global Daily Metrics - Daily snapshots
    match /global_metrics_daily/{date} {
      // Only super admins can read
      allow read: if isSuperAdmin();
      
      // Only Cloud Functions can write
      allow write: if false;
    }

    // Geographic Events Collection (for analytics dashboard)
    match /geo_events/{eventId} {
      // Only super admins can read
      allow read: if isSuperAdmin();

      // Only Cloud Functions can write
      allow write: if false;
    }
    // ============================================================================
    // Subscription & Trial Management
    // ============================================================================
    
    // Cancellation Feedback - User can write their own feedback
    match /cancellation_feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read: if false; // Only admins via backend
      allow update, delete: if false; // Immutable
    }
    
    // Pending Registrations - Created by webhook, read by Cloud Function
    match /pending_registrations/{sessionId} {
      allow read: if false; // Only Cloud Functions
      allow write: if false; // Only webhook/Cloud Functions
    }

    // ============================================================================
    // Admin audit log
    // ============================================================================

    // Records every super-admin action against a user account (delete, disable,
    // enable, plan change, bulk ops). Read-only from the client; writes happen
    // via Cloud Functions using the admin SDK (which bypasses these rules).
    match /admin_audit_log/{entryId} {
        allow read: if isSuperAdmin();
        allow write: if false;
    }

    // ============================================================================
    // LlamaParse multi-account rotation (Hito 6)
    // ============================================================================

    // LlamaParse account registry — admin reads list/toggle status; Cloud
    // Functions own the consumption counters via admin SDK (bypasses rules).
    match /llamaparseAccounts/{accountId} {
      // Super admin sees the monitoring dashboard at
      // /dashboard/admin/llamaparse-monitoring and toggles `active` to flip an
      // account out of the rotation.
      allow read: if isSuperAdmin();
      allow update: if isSuperAdmin();
      // Creation + deletion intentionally left out: account docs are seeded via
      // the `seedLlamaParseAccounts` script using the admin SDK. Restricting
      // create/delete here prevents an admin UI bug from accidentally adding
      // or removing an account in production.
      allow create, delete: if false;
    }

    // ============================================================
    // FACULTY AI MODULE - Personal Ministerial Data
    // ============================================================

    // AI Projects: root-level collection, each project belongs to one pastor
    match /ai_projects/{projectId} {
      // Superadmin read for the admin user-activity panel (recent projects).
      // Writes stay owner-only.
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isSuperAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Persisted Faculty Extractions — root-level so cross-session and
    // cross-project queries are first-class. userId is pinned on create
    // and immutable on update (the field can't be reassigned to spoof
    // ownership). Updates must keep userId === resource.data.userId.
    match /extractions/{extractionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ============================================================
    // EXEGESIS MODULE — Per-user research papers
    // ============================================================
    //
    // Top-level collection with `ownerId` field (parallels `ai_projects`,
    // not nested under /users/ because the dashboard lists across all the
    // user's papers and a top-level query is the natural fit). Reads,
    // writes, and deletes are restricted to the owner; field-level rules
    // also pin `ownerId` on create so nobody can write a doc owned by
    // someone else.
    match /exegeticalPapers/{paperId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // User-level style guides — same ownership model.
    match /userStyleGuides/{guideId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // User-level rubric templates — owner-scoped. Same ownership +
    // immutable-ownerId-on-update model as the rest of the exegesis
    // collections. Templates are FORKED to papers as snapshots
    // (paper.rubric stays embedded), so deleting a template does NOT
    // affect papers that were already created from it.
    match /userRubrics/{rubricId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Exegesis Module — reusable assignment-brief templates per user.
    // Same access pattern as userRubrics / userStyleGuides: top-level
    // collection with `ownerId` field, owner-only CRUD enforced via
    // resource.data.ownerId match.
    match /userAssignmentBriefs/{briefId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Expository assistant cache (v1.6) — shared across users to amortize
    // Gemini cost on the 5-pass pipeline. DocId is deterministic
    // (`${bookId}_${displayLanguage}_${pipelineVersion}`) so two users
    // analyzing the same book in the same language reuse the same entry.
    // Same access pattern as the existing shared caches
    // (passage_cache, quiz_cache, syntax_analysis_cache): any
    // authenticated user reads and writes; deletion intentionally blocked
    // (cache is permanent — pipeline-version bumps invalidate by docId).
    match /expositoryAssistantCache/{cacheId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }
  }
}
